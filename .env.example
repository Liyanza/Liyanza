# Domaine de production du site — utilisé pour le sitemap, robots.txt,
# les URLs canoniques et les balises Open Graph / Twitter.
# ⚠️ Ne pas mettre de slash final.
NEXT_PUBLIC_SITE_URL=https://kiyanza.com

# (Optionnel) Code de vérification Google Search Console
# Récupéré dans Search Console > Paramètres > Vérification de la propriété > balise HTML
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# (Optionnel) Code de vérification Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# URL de l'API backend Liyanza (NestJS). N'est lue que côté serveur, dans les
# Route Handlers sous src/app/api/** — le navigateur n'appelle jamais le
# backend directement, les tokens ne transitent donc jamais par le JS client.
NEXT_PUBLIC_API_URL=

# Secret partagé avec le backend (même valeur que WEB_PROXY_SECRET côté
# Liyanza-backend, openssl rand -hex 32). Lu uniquement côté serveur par
# /api/public/assistant : il accompagne l'IP réelle du visiteur, pour que le
# backend limite l'assistant vitrine par visiteur et non globalement.
# Jamais préfixé NEXT_PUBLIC_ (il ne doit pas atteindre le navigateur).
WEB_PROXY_SECRET=
